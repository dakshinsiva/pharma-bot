{
  "name": "pharma-bot",
  "version": "1.0.0",
  "description": "Outbound voice agent that phones pharmacy customers, converses in Tamil, and turns the conversation into orders and callbacks",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:system": "node scripts/test-system.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "node scripts/seed-customers.js",
    "call": "node scripts/start-calling.js",
    "voice": "node scripts/test-voice-simple.js",
    "voice-realtime": "node scripts/test-realtime-voice.js",
    "voice-file": "node scripts/test-with-voice.js"
  },
  "keywords": [
    "voice-ai",
    "voice-agent",
    "tamil",
    "speech-to-text",
    "text-to-speech",
    "twilio",
    "exotel",
    "openai",
    "pharmacy",
    "outbound-calling"
  ],
  "author": "Dakshin Siva",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/speech": "^6.2.0",
    "@google-cloud/text-to-speech": "^5.0.1",
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.20.1",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dakshinsiva/pharma-bot.git"
  },
  "homepage": "https://github.com/dakshinsiva/pharma-bot#readme",
  "engines": {
    "node": ">=18"
  }
}
