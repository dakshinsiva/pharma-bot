# Copy to .env and fill in. Nothing here is read at build time; only at server start.

# Database (SQLite file for development; any Prisma-supported URL in production)
DATABASE_URL="file:./dev.db"

# Google Cloud: service account with Speech-to-Text and Text-to-Speech enabled
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# OpenAI
OPENAI_API_KEY="sk-..."

# Telephony: set ACTIVE_TELEPHONY_PROVIDER to "twilio" or "exotel" and fill that block
ACTIVE_TELEPHONY_PROVIDER="twilio"

TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1..."

EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SID=""
EXOTEL_PHONE_NUMBER="0XXXXXXXXXX"
EXOTEL_FLOW_ID=""

# Server. BASE_URL must be reachable by the telephony provider (ngrok in development).
PORT=3000
BASE_URL="https://your-subdomain.ngrok-free.app"

# Pause between queued outbound calls, in milliseconds
CALL_DELAY_MS=5000
